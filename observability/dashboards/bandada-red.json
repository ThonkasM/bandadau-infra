  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traefik_service_requests_total{service=~\"(identity|social|media|events|wallet|ticketing|notification|insights|admin-gateway)@.*\"},service)",
          "refId": "v"
        },
        "definition": "label_values(traefik_service_requests_total{service=~\"(identity|social|media|events|wallet|ticketing|notification|insights|admin-gateway)@.*\"},service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1,
        "regex": "/(.*)@.*/"
      }
    ]
  },
  "annotations": {
    "list": []
  }
