      "description": "Cero consumidores en una cola principal = servicio consumidor caído (alerta ServiceDown)."
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Publicados / entregados / ack por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_channel_messages_published_total[$__rate_interval]))",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "publicados"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_channel_messages_delivered_total[$__rate_interval]))",
          "refId": "B",
          "editorMode": "code",
          "legendFormat": "entregados"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_channel_messages_acked_total[$__rate_interval]))",
          "refId": "C",
          "editorMode": "code",
          "legendFormat": "ack"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_channel_messages_redelivered_total[$__rate_interval]))",
          "refId": "D",
          "editorMode": "code",
          "legendFormat": "reentregados"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
