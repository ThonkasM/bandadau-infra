# Copia a terraform.tfvars (está en .gitignore) y completa. Los valores por defecto sirven para la demo.
domain         = "bandadau.lat"
instance_type  = "t3.xlarge"   # t3.large (8 GB) si se quiere gastar menos; ver README
# tailscale_auth_key = "tskey-auth-..."   # opcional: sin ella instalas Tailscale a mano
# infra_repo_url     = "https://github.com/ThonkasM/bandadau-infra.git"
# enable_static_cache = false   # apágalo si el caché de assets da problemas
