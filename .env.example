# =============================================================================
# Bandada U — bandadau-infra/.env  (SOLO desarrollo local; ningún valor es un secreto real)
# Copia: cp .env.example .env   (o `make setup`).  Índice: bandadau-docs/docs/05-infraestructura/entornos-y-variables.md
# =============================================================================

# ---- General ---------------------------------------------------------------
BASE_DOMAIN=bandada.localhost
COMPOSE_PROJECT_NAME=bandada
# Perfiles por defecto de `docker compose` (observability y llm quedan OFF; ver Makefile: make up-obs)
COMPOSE_PROFILES=infra,services
TZ=America/La_Paz
APP_ENV=local
IMAGE_TAG=local

# ---- Puertos publicados en el host (cámbialos si están ocupados) -------------
HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
POSTGRES_PORT=5432
MONGO_PORT=27017
DYNAMODB_PORT=8000
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
N8N_PORT=5678
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
GRAFANA_PORT=3300
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
# Servicios: se publican también en el host para depurar (contrato fase 1 §3.1)
IDENTITY_HOST_PORT=7001
SOCIAL_HOST_PORT=7002
MEDIA_HOST_PORT=7003
EVENTS_HOST_PORT=7004
WALLET_HOST_PORT=7005
TICKETING_HOST_PORT=7006
NOTIFICATION_HOST_PORT=7007
ADMIN_GATEWAY_HOST_PORT=7010

# ---- PostgreSQL (3 bases, 3 usuarios) ----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
IDENTITY_DB_PASSWORD=identity_dev
EVENTS_DB_PASSWORD=events_dev
WALLET_DB_PASSWORD=wallet_dev

# ---- MongoDB (rs0 de 1 nodo, keyfile generado por el contenedor mongo-keyfile) --
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=mongo_dev
SOCIAL_MONGO_PASSWORD=social_dev
MEDIA_MONGO_PASSWORD=media_dev

# ---- DynamoDB Local (credenciales ficticias) ----------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---- RabbitMQ -----------------------------------------------------------------
# Las contraseñas se materializan en rabbitmq/definitions.json con
# `make rabbit-defs` (rabbitmq/render-definitions.sh); `make setup` lo ejecuta.
RABBITMQ_DEFAULT_USER=bandada
RABBITMQ_DEFAULT_PASS=bandada
RABBITMQ_ADMIN_PASSWORD=admin
RABBITMQ_N8N_PASSWORD=n8n_dev
RABBITMQ_MONITOR_PASSWORD=monitor_dev
RABBITMQ_URL=amqp://bandada:bandada@rabbitmq:5672

# ---- MinIO ----------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_pw
MEDIA_S3_ACCESS_KEY=media-svc
MEDIA_S3_SECRET_KEY=media_svc_dev_pw
INSIGHTS_S3_ACCESS_KEY=insights-svc
INSIGHTS_S3_SECRET_KEY=insights_svc_dev_pw
# Host con el que se FIRMAN las URLs que abre el cliente (navegador/emulador)
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ---- Seguridad (todo de desarrollo) ---------------------------------------------
JWT_ISSUER=http://api.${BASE_DOMAIN}
JWT_KEY_ID=dev-2026-10
# identity genera su par RS256 si no existe; `make keys` lo pre-genera en ./secrets/
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
ACCESS_TOKEN_TTL=PT15M
REFRESH_TOKEN_TTL=P30D
HANDOFF_CODE_TTL=PT60S
# Entorno de identity que habilita la verificación de email por log y la contraseña demo
SPRING_PROFILES_ACTIVE=dev

# Client credentials (token de servicio para /internal). id:secret,id:secret...
ADMIN_GATEWAY_SERVICE_CLIENT_SECRET=dev-secret-admin-gateway
SOCIAL_SERVICE_CLIENT_SECRET=dev-secret-social
MEDIA_SERVICE_CLIENT_SECRET=dev-secret-media
EVENTS_SERVICE_CLIENT_SECRET=dev-secret-events
WALLET_SERVICE_CLIENT_SECRET=dev-secret-wallet
TICKETING_SERVICE_CLIENT_SECRET=dev-secret-ticketing
NOTIFICATION_SERVICE_CLIENT_SECRET=dev-secret-notification
INSIGHTS_SERVICE_CLIENT_SECRET=dev-secret-insights
N8N_SERVICE_CLIENT_SECRET=dev-secret-n8n
SEED_SERVICE_CLIENT_SECRET=dev-secret-seed
SERVICE_CLIENTS=admin-gateway:dev-secret-admin-gateway,social-service:dev-secret-social,media-service:dev-secret-media,events-service:dev-secret-events,wallet-service:dev-secret-wallet,ticketing-service:dev-secret-ticketing,notification-service:dev-secret-notification,insights-service:dev-secret-insights,n8n:dev-secret-n8n,bandada-seed:dev-secret-seed

# Llave ES256 del QR (ticketing). `make keys` genera ./secrets/qr-es256.pem
QR_SIGNING_KEY_PATH=/run/secrets/qr-es256.pem
QR_SIGNING_KID=tk-2026-10
QR_KEY_ID=dev-1

# Laravel (wallet, notification): llaves de desarrollo (php artisan key:generate no hace falta)
WALLET_APP_KEY=base64:sI6Al+9f2dHMvRt3m6jOAK3HEg5Ho727MVuY7G7Z0XU=
NOTIFICATION_APP_KEY=base64:bW1Z/RBrb7VtYMgIi9tyAIHKM68U3Gj5SN9nIIKUWZo=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# CORS (orígenes de desarrollo del contrato fase 1 §3.4; los usan Traefik y los servicios)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4201,http://localhost:8081,http://${BASE_DOMAIN},http://app.${BASE_DOMAIN},http://admin.${BASE_DOMAIN},http://mfe.${BASE_DOMAIN}

# ---- Comunes a los servicios ---------------------------------------------------------
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
IDEMPOTENCY_TABLE=bandada-idempotency
TICKETING_TABLE=bandada-ticketing
NOTIFICATIONS_TABLE=bandada-notifications
INSIGHTS_TABLE=bandada-insights
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
# Sin el perfil `observability` no hay colector: deja OTEL_SDK_DISABLED=true (Java/Node/PHP lo respetan)
OTEL_SDK_DISABLED=true
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# ---- identity-service -------------------------------------------------------------------
APP_BASE_URL=http://app.${BASE_DOMAIN}
ADMIN_BASE_URL=http://admin.${BASE_DOMAIN}
MAIL_FROM=no-reply@${BASE_DOMAIN}

# ---- social-service -----------------------------------------------------------------------
REPORT_HIDE_THRESHOLD=3
FEED_MODEL_PATH=./models/feed-ranker/coefficients.json

# ---- media-service (MODERATION_MODE: allow-all | manual | onnx) ---------------------------------------------------------
MODERATION_MODE=allow-all
S3_BUCKET_MEDIA=bandada-media
S3_BUCKET_MODELS=bandada-models
UPLOAD_URL_TTL_SECONDS=900
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=52428800
MODEL_NSFW_VERSION=1.0.0
MODEL_NAME=nsfw-classifier
MODEL_VARIANT=fp32
ORT_THREADS=2
MODEL_VIOLENCE_VERSION=1.0.0
MODEL_CLIP_VERSION=1.0.0
MODERATION_BLOCK_THRESHOLD=0.85
MODERATION_REVIEW_THRESHOLD=0.5
VIDEO_FRAME_INTERVAL_SECONDS=2
VIDEO_MAX_FRAMES=30

# ---- events-service ----------------------------------------------------------------------------
SAGA_STEP_TIMEOUT=PT30S
SAGA_SCHEDULER_INTERVAL=PT5S
SAGA_COMMAND_MAX_RETRIES=3
OUTBOX_RELAY_INTERVAL=PT1S

# ---- wallet-service ------------------------------------------------------------------------------
PAYMENT_CHECKOUT_BASE_URL=http://app.${BASE_DOMAIN}/wallet/checkout
SIMULATE_PAYMENT_ENABLED=true
PAYMENT_SIMULATOR_ENABLED=true
TOPUP_PACKAGES=CREDITS_20,CREDITS_50,CREDITS_100
# Comandos de los procesos auxiliares (según wallet-service/AGENTS.md)
WALLET_WORKER_CMD=php artisan wallet:consume-commands
WALLET_RELAY_CMD=php artisan wallet:relay-outbox

# ---- ticketing-service / caos (demo del rollback de la SAGA, D2) ------------------------------------
CHAOS_TICKETING_FAIL=false
CHAOS_WALLET_DELAY_MS=0

# ---- notification-service ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=no-reply@${BASE_DOMAIN}
NOTIFICATION_TTL_DAYS=90
PUSH_ENABLED=false
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
APP_DEEP_LINK_BASE=http://app.${BASE_DOMAIN}
NOTIFICATION_WORKER_CMD=php artisan notifications:consume
NOTIFICATION_RELAY_CMD=php artisan notifications:relay-outbox

# ---- admin-gateway ------------------------------------------------------------------------------------------
GRAPHQL_MAX_DEPTH=7
GRAPHQL_MAX_COMPLEXITY=1000
GRAPHQL_INTROSPECTION=true
HTTP_TIMEOUT_MS=3000

# ---- n8n (automatización, fase 2: workflows de n8n/workflows importados al arrancar) --------------------------------------------
N8N_ENCRYPTION_KEY=dev-n8n-key-32-chars-xxxxxxxxxxxx
N8N_PROTOCOL=http
GENERIC_TIMEZONE=America/La_Paz
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
BANDADA_API_URL=http://api.${BASE_DOMAIN}/api/v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=

# ---- Observabilidad (perfil `observability`, OFF por defecto) ---------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Solo prod (vacío en local) ------------------------------------------------------------------------------------
OPS_BASIC_AUTH=
ORIGIN_VERIFY_SECRET=

# ---- seed / smoke (se ejecutan en el host contra los puertos publicados) --------------------------------------
SEED_API_URL=http://api.${BASE_DOMAIN}/api/v1
SEED_GRAPHQL_URL=http://api.${BASE_DOMAIN}/graphql
SEED_IDENTITY_INTERNAL_URL=http://localhost:7001
SEED_MAILPIT_URL=http://localhost:8025
SEED_DEMO_PASSWORD=Bandada#2026
# Propietario de n8n gestionado por variables (contraseña de desarrollo: Bandada-n8n-dev1). Hash bcrypt entre comillas simples.
N8N_OWNER_EMAIL=admin@bandada.localhost
N8N_OWNER_PASSWORD_HASH='$2a$10$wIUqrEPoasp98QcBuWem8udQbSM7qKPSDwCbvfbigoMocvW1rJ7.C'
N8N_WELCOME_DELAY=3600
N8N_REPORT_POLL_SECONDS=60
# JSON de destinatarios del equipo; vacío = moderacion@bandada.localhost (es, MODERATOR) y admin@bandada.localhost (en, ADMIN)
N8N_STAFF_RECIPIENTS=
N8N_ERROR_EMAIL=devs@bandada.localhost

# ---- insights-service (fase 2: agentes + MCP) ------------------------------------------------------
# LLM_PROVIDER: stub (determinista, sin red ni claves: por defecto) | claude (requiere ANTHROPIC_API_KEY) | ollama (perfil llm)
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_MODEL_CHEAP=claude-haiku-5-5
# TTS_PROVIDER: none (reporte sin audio: por defecto) | piper | polly
TTS_PROVIDER=none
S3_BUCKET_REPORTS=bandada-reports
MONITORING_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=20000
# Solo con el perfil observability (Prometheus de otel-lgtm), p. ej. http://lgtm:9090 — habilita la herramienta MCP query_metrics
PROMETHEUS_URL=
