    {
      "id": "f550406b-1aae-4203-a300-059e86c78aa2",
      "name": "Compose staff emails (es/en)",
      "parameters": {
        "jsCode": "\n\nconst DEFAULT_STAFF = [\n  { email: 'moderacion@bandada.localhost', locale: 'es', roles: ['MODERATOR'] },\n  { email: 'admin@bandada.localhost', locale: 'en', roles: ['ADMIN'] },\n];\nfunction staff(role) {\n  let list = null;\n  try { list = JSON.parse($env.N8N_STAFF_RECIPIENTS || ''); } catch (e) { list = null; }\n  if (!Array.isArray(list)) list = DEFAULT_STAFF;\n  return list.filter((r) => (r.roles || []).includes(role));\n}\nconst esc = (s) => String(s ?? '').replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst layout = (title, bodyHtml) => '<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:auto\"><h2 style=\"color:#4f46e5\">' + esc(title) + '</h2>' + bodyHtml + '<hr><p style=\"color:#888;font-size:12px\">Bandada U</p></div>';\nconst laPaz = (iso) => new Date(new Date(iso).getTime() - 4 * 3600 * 1000).toISOString().replace('T', ' ').slice(0, 16) + ' (La Paz)';\n\n\nasync function telegram(helpers, text) {\n  const token = $env.TELEGRAM_BOT_TOKEN, chat = $env.TELEGRAM_STAFF_CHAT_ID;\n  if (!token || !chat) return false;\n  await helpers.httpRequest({ method: 'POST', url: 'https://api.telegram.org/bot' + token + '/sendMessage', body: { chat_id: chat, text }, json: true, timeout: 10000 });\n  return true;\n}\n\nconst d = $('Dedupe key').first().json.event.data;\nconst admin = $env.BANDADA_ADMIN_URL || 'http://admin.bandada.localhost';\nconst link = admin + '/alerts/' + d.alertId;\nconst T = {\n  es: { subject: 'ALERTA CRÍTICA: ' + d.kind, body: d.message + '\\nTipo: ' + d.kind + '\\nVer en el panel: ' + link },\n  en: { subject: 'CRITICAL ALERT: ' + d.kind, body: d.message + '\\nKind: ' + d.kind + '\\nView in the admin panel: ' + link },\n};\ntry { await telegram(this.helpers, T.es.subject + '\\n' + T.es.body); } catch (e) { /* opcional */ }\nreturn staff('ADMIN').map((r) => { const m = T[r.locale === 'en' ? 'en' : 'es']; return { json: { to: r.email, subject: m.subject, text: m.body, html: layout(m.subject, '<p>' + esc(m.body).replace(/\\n/g, '<br>') + '</p>') } }; });\n"
      },
