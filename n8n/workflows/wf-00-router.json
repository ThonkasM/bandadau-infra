      "id": "24182fe1-5001-458f-adc5-50cdb1ec872f",
      "name": "Parse CloudEvent",
      "parameters": {
        "jsCode": "\nconst out = [];\nfor (const it of $input.all()) {\n  let ce = it.json;\n  if (typeof ce === 'string') ce = JSON.parse(ce);\n  if (ce.content && !ce.type) { try { ce = JSON.parse(ce.content); } catch (e) { /* abajo falla */ } }\n  if (ce.specversion !== '1.0' || !ce.id || !ce.type || !ce.data) throw new Error('CloudEvent invalido (specversion/id/type/data)');\n  out.push({ json: ce });\n}\nreturn out;\n"
      },
      "position": [
        260,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
