    {
      "id": "8b165638-3d0f-4f68-a4c7-5af2b2bb0d93",
      "name": "Compose email (es/en)",
      "parameters": {
        "jsCode": "\n\nconst DEFAULT_STAFF = [\n  { email: 'moderacion@bandada.localhost', locale: 'es', roles: ['MODERATOR'] },\n  { email: 'admin@bandada.localhost', locale: 'en', roles: ['ADMIN'] },\n];\nfunction staff(role) {\n  let list = null;\n  try { list = JSON.parse($env.N8N_STAFF_RECIPIENTS || ''); } catch (e) { list = null; }\n  if (!Array.isArray(list)) list = DEFAULT_STAFF;\n  return list.filter((r) => (r.roles || []).includes(role));\n}\nconst esc = (s) => String(s ?? '').replace(/[&<>\"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst layout = (title, bodyHtml) => '<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:auto\"><h2 style=\"color:#4f46e5\">' + esc(title) + '</h2>' + bodyHtml + '<hr><p style=\"color:#888;font-size:12px\">Bandada U</p></div>';\nconst laPaz = (iso) => new Date(new Date(iso).getTime() - 4 * 3600 * 1000).toISOString().replace('T', ' ').slice(0, 16) + ' (La Paz)';\n\nconst d = $('Key').first().json.event.data;\nconst locale = d.locale === 'en' ? 'en' : 'es';\nconst groups = ($json.items || []).slice(0, 3);\nconst app = $env.BANDADA_APP_URL || 'http://app.bandada.localhost';\nconst T = {\n  es: { subject: '¡Bienvenido a Bandada U, ' + d.displayName + '!', hi: 'Hola ' + d.displayName + ', tu cuenta está lista.', intro: 'Bandada U es la red de estudiantes de tu universidad: eventos, grupos de estudio y mucho más.', gh: 'Grupos que podrían interesarte', cta: 'Abrir Bandada U' },\n  en: { subject: 'Welcome to Bandada U, ' + d.displayName + '!', hi: 'Hi ' + d.displayName + ', your account is ready.', intro: 'Bandada U is your university student network: events, study groups and more.', gh: 'Groups you might like', cta: 'Open Bandada U' },\n}[locale];\nconst gHtml = groups.length ? '<h3>' + T.gh + '</h3><ul>' + groups.map((g) => '<li>' + esc(g.name) + (g.subject ? ' — ' + esc(g.subject) : '') + '</li>').join('') + '</ul>' : '';\nconst gText = groups.length ? '\\n\\n' + T.gh + ':\\n' + groups.map((g) => '- ' + g.name).join('\\n') : '';\nreturn [{ json: {\n  to: d.email, locale, subject: T.subject,\n  html: layout(T.subject, '<p>' + esc(T.hi) + '</p><p>' + esc(T.intro) + '</p>' + gHtml + '<p><a href=\"' + esc(app) + '\">' + T.cta + '</a></p>'),\n  text: T.hi + '\\n' + T.intro + gText + '\\n\\n' + app,\n} }];\n"
      },
