    {
      "id": "117ca798-c4fd-4bc0-a6d5-f846533e0bce",
      "name": "Build notification",
      "parameters": {
        "jsCode": "\n// Destinatarios: duenos de los grupos publicos de la carrera del organizador (el contrato no expone miembros).\n\n// UUID determinista (v8) derivado de un texto: los servicios exigen Idempotency-Key con forma de UUID.\nfunction detUuid(str) {\n  let h1 = 0xdeadbeef, h2 = 0x41c6ce57, h3 = 0x9e3779b9, h4 = 0x85ebca6b;\n  for (let i = 0; i < str.length; i++) { const c = str.charCodeAt(i);\n    h1 = Math.imul(h1 ^ c, 2654435761); h2 = Math.imul(h2 ^ c, 1597334677); h3 = Math.imul(h3 ^ c, 2246822507); h4 = Math.imul(h4 ^ c, 3266489909); }\n  h1 = Math.imul(h1 ^ (h2 >>> 15), 2246822507) ^ Math.imul(h3 ^ (h4 >>> 13), 3266489909);\n  h2 = Math.imul(h2 ^ (h3 >>> 15), 2246822507) ^ Math.imul(h4 ^ (h1 >>> 13), 3266489909);\n  h3 = Math.imul(h3 ^ (h4 >>> 15), 2246822507) ^ Math.imul(h1 ^ (h2 >>> 13), 3266489909);\n  h4 = Math.imul(h4 ^ (h1 >>> 15), 2246822507) ^ Math.imul(h2 ^ (h3 >>> 13), 3266489909);\n  const hex = [h1, h2, h3, h4].map((n) => (n >>> 0).toString(16).padStart(8, '0')).join('');\n  return hex.slice(0, 8) + '-' + hex.slice(8, 12) + '-8' + hex.slice(13, 16) + '-a' + hex.slice(17, 20) + '-' + hex.slice(20, 32);\n}\n\nconst ev = $('Key').first().json.event, d = ev.data;\nconst ids = [...new Set(($json.items || []).map((g) => g.ownerId).filter((u) => u && u !== d.organizerId))].sort();\nif (!ids.length) return [];\nconst laPaz = new Date(new Date(d.startsAt).getTime() - 4 * 3600 * 1000).toISOString().replace('T', ' ').slice(0, 16) + ' (La Paz)';\nreturn [{ json: {\n  idemKey: detUuid('n8n:wf-06:' + ev.id),\n  body: { userIds: ids, type: 'NEW_EVENT', dedupeKey: 'new-event:' + d.eventId,\n    params: { eventTitle: d.title, startsAt: d.startsAt, startsAtText: laPaz, venue: d.venue || '' },\n    data: { eventId: d.eventId, deepLink: 'bandada://events/' + d.eventId } },\n} }];\n"
      },
      "position": [
        1300,
        300
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
