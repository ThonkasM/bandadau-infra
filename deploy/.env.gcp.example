# =============================================================================
# Bandada U — VM de GCP (wallet-service + worker + relay). Copia: deploy/render-env.sh gcp → deploy/.env.gcp (git-ignored)
# Los secretos son los MISMOS que en .env.aws (render-env.sh los reusa de deploy/.secrets).
# =============================================================================
BASE_DOMAIN=bandada.example.com          # igual que en .env.aws
GHCR_OWNER=tu-usuario-o-org-de-github
IMAGE_TAG=v1
TZ=America/La_Paz
AWS_REGION=us-east-1

# IP Tailscale de las VMs (RELLENAR; las mismas que en .env.aws)
TS_IP_AWS=100.x.x.x
TS_IP_AZURE=100.x.x.x
TS_IP_GCP=100.x.x.x

RABBITMQ_WALLET_SERVICE_USER=wallet-service
RABBITMQ_WALLET_SERVICE_PASSWORD=@@rabbit_wallet@@
WALLET_DB_PASSWORD=@@wallet_db@@
WALLET_APP_KEY=@@b64:wallet_app_key@@
PAYMENT_WEBHOOK_SECRET=@@payment_webhook@@
PAYMENT_GATEWAY_MODE=simulate
PAYMENT_SIMULATOR_ENABLED=false         # true solo con WALLET_APP_ENV=staging (demo); en production el validador exige false
TOPUP_PACKAGES=CREDITS_20,CREDITS_50,CREDITS_100
CHAOS_WALLET_DELAY_MS=0                  # solo se sube para la demo de timeout de la SAGA

# Usuario IAM de wallet para DynamoDB (RELLENAR; lo creas en AWS, ver guia-despliegue.md). NO es un secreto generado.
WALLET_AWS_ACCESS_KEY_ID=RELLENAR
WALLET_AWS_SECRET_ACCESS_KEY=RELLENAR

WALLET_APP_ENV=production   # demo: staging + PAYMENT_SIMULATOR_ENABLED=true habilita simulate-payment
