# =============================================================================
# Bandada U — VM de Azure (events-service). Copia: deploy/render-env.sh azure → deploy/.env.azure (git-ignored)
# Los secretos son los MISMOS que en .env.aws (render-env.sh los reusa de deploy/.secrets).
# =============================================================================
BASE_DOMAIN=bandada.example.com          # igual que en .env.aws
GHCR_OWNER=tu-usuario-o-org-de-github
IMAGE_TAG=v1
TZ=America/La_Paz

# IP Tailscale de las VMs (RELLENAR; las mismas que en .env.aws)
TS_IP_AWS=100.x.x.x
TS_IP_AZURE=100.x.x.x
TS_IP_GCP=100.x.x.x

SPRING_PROFILES_ACTIVE=prod
RABBITMQ_EVENTS_SERVICE_USER=events-service
RABBITMQ_EVENTS_SERVICE_PASSWORD=@@rabbit_events@@
EVENTS_DB_PASSWORD=@@events_db@@
EVENTS_SERVICE_CLIENT_SECRET=@@sc_events@@
INTERNAL_SCOPES_ENFORCED=true
COVER_CHECK=on
# SAGA: no reducir SAGA_STEP_TIMEOUT (hay latencia entre nubes)
SAGA_STEP_TIMEOUT=PT30S
SAGA_SCHEDULER_INTERVAL=PT5S
SAGA_COMMAND_MAX_RETRIES=3
OUTBOX_RELAY_INTERVAL=PT1S
