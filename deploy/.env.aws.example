# =============================================================================
# Bandada U — VM de AWS (EC2). Copia: deploy/render-env.sh aws   → deploy/.env.aws (git-ignored)
# Los marcadores de secreto (arroba arroba nombre arroba arroba) los reemplaza render-env.sh (los MISMOS valores se reusan en .env.azure y .env.gcp).
# Los valores marcados "RELLENAR" los escribes tú.
# =============================================================================

# ---- General (RELLENAR) -----------------------------------------------------------
BASE_DOMAIN=bandadau.lat                 # dominio en Route 53; api., app., admin., mfe., s3., n8n., mail., rabbit., minio. llegan por CloudFront (ADR-0026)
ORIGIN_VERIFY=RELLENAR                   # terraform output -raw origin_verify_secret (Traefik exige X-Origin-Verify con este valor)
GHCR_OWNER=tu-usuario-o-org-de-github    # en minúsculas
IMAGE_TAG=v1                             # etiqueta por defecto; deploy.sh puede fijar TAG_<SERVICIO> por servicio
TZ=America/La_Paz
AWS_REGION=us-east-1

# ---- Red privada Tailscale (RELLENAR con `tailscale ip -4` de cada VM) ----------------------
TS_IP_AWS=100.x.x.x
TS_IP_AZURE=100.x.x.x
TS_IP_GCP=100.x.x.x

# ---- Frontends estáticos (nginx) ------------------------------------------------------------
SITES_DIR=/opt/bandada/sites
CORS_ORIGINS=https://${BASE_DOMAIN},https://www.${BASE_DOMAIN},https://app.${BASE_DOMAIN},https://admin.${BASE_DOMAIN},https://mfe.${BASE_DOMAIN}

# ---- Modo de ejecución -------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
INTERNAL_SCOPES_ENFORCED=true
COVER_CHECK=on
MODERATION_MODE=allow-all
LLM_PROVIDER=stub
TTS_PROVIDER=none
PUSH_ENABLED=false

# ---- PostgreSQL (3 bases, 3 usuarios) -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=@@postgres_admin@@
IDENTITY_DB_PASSWORD=@@identity_db@@
EVENTS_DB_PASSWORD=@@events_db@@
WALLET_DB_PASSWORD=@@wallet_db@@

# ---- MongoDB ---------------------------------------------------------------------------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=@@mongo_root@@
SOCIAL_MONGO_PASSWORD=@@social_mongo@@
MEDIA_MONGO_PASSWORD=@@media_mongo@@

# ---- RabbitMQ (render-definitions.sh usa estas contraseñas LITERALES) -------------------------------------------
RABBITMQ_DEFAULT_USER=bandada
RABBITMQ_DEFAULT_PASS=@@rabbit_default@@
RABBITMQ_ADMIN_PASSWORD=@@rabbit_admin@@
RABBITMQ_N8N_PASSWORD=@@rabbit_n8n@@
RABBITMQ_MONITOR_PASSWORD=@@rabbit_monitor@@
RABBITMQ_IDENTITY_SERVICE_USER=identity-service
RABBITMQ_IDENTITY_SERVICE_PASSWORD=@@rabbit_identity@@
RABBITMQ_SOCIAL_SERVICE_USER=social-service
RABBITMQ_SOCIAL_SERVICE_PASSWORD=@@rabbit_social@@
RABBITMQ_MEDIA_SERVICE_USER=media-service
RABBITMQ_MEDIA_SERVICE_PASSWORD=@@rabbit_media@@
RABBITMQ_EVENTS_SERVICE_USER=events-service
RABBITMQ_EVENTS_SERVICE_PASSWORD=@@rabbit_events@@
RABBITMQ_WALLET_SERVICE_USER=wallet-service
RABBITMQ_WALLET_SERVICE_PASSWORD=@@rabbit_wallet@@
RABBITMQ_TICKETING_SERVICE_USER=ticketing-service
RABBITMQ_TICKETING_SERVICE_PASSWORD=@@rabbit_ticketing@@
RABBITMQ_NOTIFICATION_SERVICE_USER=notification-service
RABBITMQ_NOTIFICATION_SERVICE_PASSWORD=@@rabbit_notification@@
RABBITMQ_INSIGHTS_SERVICE_USER=insights-service
RABBITMQ_INSIGHTS_SERVICE_PASSWORD=@@rabbit_insights@@
RABBITMQ_ADMIN_GATEWAY_USER=admin-gateway
RABBITMQ_ADMIN_GATEWAY_PASSWORD=@@rabbit_admin_gateway@@

# ---- MinIO (media y audio de reportes) -------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=@@minio_root@@
MEDIA_S3_ACCESS_KEY=media-svc
MEDIA_S3_SECRET_KEY=@@media_s3@@
INSIGHTS_S3_ACCESS_KEY=insights-svc
INSIGHTS_S3_SECRET_KEY=@@insights_s3@@

# ---- Seguridad -----------------------------------------------------------------------------------------------------------
JWT_KEY_ID=prod-2026-11
JWT_KEK=@@jwt_kek@@
ADMIN_GATEWAY_SERVICE_CLIENT_SECRET=@@sc_admin_gateway@@
SOCIAL_SERVICE_CLIENT_SECRET=@@sc_social@@
MEDIA_SERVICE_CLIENT_SECRET=@@sc_media@@
EVENTS_SERVICE_CLIENT_SECRET=@@sc_events@@
WALLET_SERVICE_CLIENT_SECRET=@@sc_wallet@@
TICKETING_SERVICE_CLIENT_SECRET=@@sc_ticketing@@
NOTIFICATION_SERVICE_CLIENT_SECRET=@@sc_notification@@
INSIGHTS_SERVICE_CLIENT_SECRET=@@sc_insights@@
N8N_SERVICE_CLIENT_SECRET=@@sc_n8n@@
SEED_SERVICE_CLIENT_SECRET=@@sc_seed@@
SERVICE_CLIENTS=admin-gateway:${ADMIN_GATEWAY_SERVICE_CLIENT_SECRET},social-service:${SOCIAL_SERVICE_CLIENT_SECRET},media-service:${MEDIA_SERVICE_CLIENT_SECRET},events-service:${EVENTS_SERVICE_CLIENT_SECRET},wallet-service:${WALLET_SERVICE_CLIENT_SECRET},ticketing-service:${TICKETING_SERVICE_CLIENT_SECRET},notification-service:${NOTIFICATION_SERVICE_CLIENT_SECRET},insights-service:${INSIGHTS_SERVICE_CLIENT_SECRET},n8n:${N8N_SERVICE_CLIENT_SECRET},bandada-seed:${SEED_SERVICE_CLIENT_SECRET}
WALLET_APP_KEY=@@b64:wallet_app_key@@
NOTIFICATION_APP_KEY=@@b64:notification_app_key@@
PAYMENT_WEBHOOK_SECRET=@@payment_webhook@@
N8N_ENCRYPTION_KEY=@@n8n_key@@
N8N_OWNER_EMAIL=admin@example.com

# ---- Correo: Mailpit atrapa los correos de la demo (UI en https://mail.${BASE_DOMAIN}, con usuario/clave de ops.htpasswd) ----
MAIL_FROM=no-reply@${BASE_DOMAIN}
